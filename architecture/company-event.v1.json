{
  "schema": "company-event/v1",
  "required": ["event_id","seq","occurred_at","event_type","source","visibility","summary"],
  "fields": {
    "event_id":"uuid",
    "seq":"monotonic integer within run",
    "occurred_at":"RFC3339 timestamp",
    "company_id":"string",
    "subsidiary_id":"string|null",
    "task_id":"string|null",
    "run_id":"string|null",
    "session_id":"string|null",
    "correlation_id":"string|null",
    "causation_id":"string|null",
    "event_type":"enum",
    "source":{"type":"human|ceo|subsidiary|agent|workflow|service|tool|system","id":"string"},
    "target":{"type":"ceo|subsidiary|agent|workflow|service|tool|system","id":"string"},
    "phase":"string|null",
    "status":"pending|planning|working|awaiting_input|blocked|completed|failed|error|terminated|archived|null",
    "visibility":"human|ceo|organization|audit|system",
    "summary":"short verifiable statement; never hidden chain-of-thought",
    "evidence_refs":"array<string>",
    "artifact_refs":"array<string>",
    "tool_call":{"tool_id":"string","action":"string","result":"started|succeeded|failed"},
    "approval":{"request_id":"string","risk":"low|medium|high","state":"requested|approved|rejected|expired"},
    "cost":{"currency":"CNY","estimated":"number|null","actual":"number|null"},
    "error":{"code":"string","message":"string","retryable":"boolean"},
    "meta":"object"
  },
  "event_types": [
    "command.accepted",
    "routing.decided",
    "task.created",
    "task.status.changed",
    "subsidiary.assigned",
    "workflow.started",
    "workflow.phase.started",
    "workflow.phase.completed",
    "agent.started",
    "agent.progress.reported",
    "agent.completed",
    "service.call.started",
    "service.call.completed",
    "knowledge.query.started",
    "knowledge.query.completed",
    "tool.call.started",
    "tool.call.completed",
    "artifact.created",
    "evidence.registered",
    "approval.requested",
    "approval.resolved",
    "budget.warning",
    "task.blocked",
    "task.completed",
    "task.failed"
  ],
  "ui_projections": {
    "ceo_conversation":["command.accepted","routing.decided","approval.requested","task.completed","task.failed"],
    "virtual_office":["subsidiary.assigned","agent.started","agent.progress.reported","agent.completed"],
    "task_graph":["task.created","task.status.changed","workflow.phase.started","workflow.phase.completed","task.blocked"],
    "infrastructure_drawer":["service.call.started","service.call.completed","knowledge.query.started","knowledge.query.completed","tool.call.started","tool.call.completed","budget.warning"],
    "evidence_panel":["artifact.created","evidence.registered"],
    "approval_panel":["approval.requested","approval.resolved"]
  }
}
